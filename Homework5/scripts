#!/bin/bash


echo "Please input source path for file (including file name)"
read source

if ! cat "$source">/dev/null 2>&1; then
    echo "No such file"
    exit 1
fi

echo "Please input destination path for file"
read destination

if ! ls "$destination">/dev/null 2>&1; then
    echo "Please check destination path"
    exit 1
fi

if cp "$source" "$destination"; then
         echo "File copied successfully."
fi


